body {
    font-family: Arial, sans-serif;
    background: #e3f2fd;
    margin: 0;
    padding: 0;
}

.contenedor {
    width: 400px;
    background: white;
    margin: 40px auto;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0px 4px 10px rgba(0,0,0,0.2);
}

h1 {
    text-align: center;
    color: #1565c0;
}

label {
    display: block;
    margin-top: 15px;
    font-weight: bold;
}

input,
select {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    border-radius: 8px;
    border: 1px solid #999;
    box-sizing: border-box;
}

input[type="range"] {
    width: 100%;
}

span {
    font-weight: bold;
    color: #d32f2f;
}

small {
    color: gray;
}

button {
    width: 100%;
    margin-top: 20px;
    padding: 12px;
    background: #1565c0;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #0d47a1;
}
